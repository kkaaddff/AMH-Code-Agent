data: {"toolName":"propose_file","callId":"chatcmpl-tool-eb57973d40224e00ab28d3284ee39697","params":{"path":"src/components/SearchAndFilter.tsx","kind":"file","description":"搜索框和筛选区域组件，包含搜索输入框和三个筛选下拉选项","content":"import React from 'react';\nimport {\n  SearchInput,\n  Dropdown,\n  Row,\n  Col\n} from '@fta/components';\nimport { FilterOption, FilterState } from '../types/driver';\n\ninterface SearchAndFilterProps {\n  searchKeyword: string;\n  onSearchChange: (value: string) => void;\n  filters: FilterState;\n  onFilterChange: (key: string, value: any) => void;\n  filterOptions: FilterOption[];\n}\n\nconst SearchAndFilter: React.FC<SearchAndFilterProps> = ({\n  searchKeyword,\n  onSearchChange,\n  filters,\n  onFilterChange,\n  filterOptions\n}) => {\n  return (\n    <div style={{ \n      padding: '16px 24px', \n      backgroundColor: '#FFFFFF',\n      borderBottom: '1px solid #F0F0F0'\n    }}>\n      {/* 搜索框 */}\n      <SearchInput\n        placeholder=\"请输入司机姓名/车牌号\"\n        value={searchKeyword}\n        onChange={onSearchChange}\n        style={{ \n          marginBottom: '16px',\n          height: '72px'\n        }}\n      />\n      \n      {/* 筛选选项 */}\n      <Row gutter={0} justify=\"space-between\">\n        {filterOptions.map(option => (\n          <Col span={8} key={option.key}>\n            <Dropdown\n              title={option.title}\n              selected={filters[option.key as keyof typeof filters]}\n              onSelect={(value) => onFilterChange(option.key, value)}\n              style={{\n                height: '80px',\n                backgroundColor: '#FFFFFF',\n                border: 'none'\n              }}\n            />\n          </Col>\n        ))}\n      </Row>\n    </div>\n  );\n};\n\nexport default SearchAndFilter;"},"category":"write"}

