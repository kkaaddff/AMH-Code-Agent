data: {"toolName":"propose_file","callId":"chatcmpl-tool-0b8499a310bf45ba970a66ad2731a22b","params":{"path":"src/pages/MyTransportPool.tsx","kind":"file","description":"我的运力池页面 - 显示司机列表，支持搜索、筛选和联系功能","content":"import React, { useState, useEffect } from 'react';\nimport { \n  StatusBar, \n  NavigationBar, \n  SearchInput, \n  Dropdown, \n  Card, \n  Avatar, \n  Tag, \n  Button, \n  TabBar,\n  Icon,\n  Text,\n  Container,\n  Row,\n  Col\n} from '@fta/components';\n\n// 司机信息类型定义\ninterface DriverInfo {\n  id: string;\n  name: string;\n  licensePlate: string;\n  vehicleType: string;\n  avatar: string;\n  callCount: number;\n  rating: number;\n  dealCount: number;\n  tags: string[];\n  routes: string;\n  location: {\n    address: string;\n    updateTime: string;\n    distance: string;\n    isLoading?: boolean;\n  };\n  phoneNumber: string;\n}\n\n// 模拟数据\nconst mockDrivers: DriverInfo[] = [\n  {\n    id: '1',\n    name: '夏师傅',\n    licensePlate: '苏A6***G',\n    vehicleType: '9.6米/平板',\n    avatar: 'https://mg.amh-group.com/mastergo-default/88642146392973/88654546891508/710b4cc77ab27343166e5b04e896da65.jpg',\n    callCount: 4,\n    rating: 98,\n    dealCount: 999,\n    tags: ['标签'],\n    routes: '上海-南京，苏州-上海，呼和浩特-南宁，鄂尔多斯-哈尔滨，张家界-石家庄',\n    location: {\n      address: '苏州市 吴江区',\n      updateTime: '2023-11-08 12:00:00',\n      distance: '距我21km'\n    },\n    phoneNumber: '13800138000'\n  },\n  {\n    id: '2',\n    name: '夏师傅',\n    licensePlate: '苏A6***G', \n    vehicleType: '9.6米/平板',\n    avatar: 'https://mg.amh-group.com/mastergo-default/88642146392973/88654546891508/0dd686894c9af729504f50069b15f3e8.jpg',\n    callCount: 4,\n    rating: 98,\n    dealCount: 999,\n    tags: ['标签'],\n    routes: '上海-南京，苏州-上海，呼和浩特-南宁，鄂尔多斯-哈尔滨，张家界-石家庄',\n    location: {\n      address: '苏州市 吴江区',\n      updateTime: '2023-11-08 12:00:00',\n      distance: '距我21km',\n      isLoading: true\n    },\n    phoneNumber: '13800138001'\n  },\n  {\n    id: '3',\n    name: '夏师傅',\n    licensePlate: '苏A6***G',\n    vehicleType: '9.6米/平板', \n    avatar: 'https://mg.amh-group.com/mastergo-default/88642146392973/88654546891508/c14225c47d74a5a0012c53928b6560b1.jpg',\n    callCount: 4,\n    rating: 98,\n    dealCount: 999,\n    tags: ['标签'],\n    routes: '上海市，苏州市',\n    location: {\n      address: '苏州市 吴江区',\n      updateTime: '2023-11-08 12:00',\n      distance: '距我21km'\n    },\n    phoneNumber: '13800138002'\n  },\n  {\n    id: '4',\n    name: '刘师傅',\n    licensePlate: '苏A6***V',\n    vehicleType: '13米/平板 字段超出折行展示',\n    avatar: 'https://mg.amh-group.com/mastergo-default/88642146392973/88654546891508/cc0bfc7e0f0b7259e09f8037aab99d89.jpg',\n    callCount: 4,\n    rating: 98,\n    dealCount: 999,\n    tags: ['标签最多展示14个字符', '标签最多展示14个字符', '标签最多展示14个字符', '标签'],\n    routes: '上海-南京，苏州-上海，呼和浩特-南宁，鄂尔多斯-哈尔滨，张家界-石家庄',\n    location: {\n      address: '苏州市 吴江区',\n      updateTime: '2023-11-08 12:00:00',\n      distance: '距我21km',\n      isLoading: true\n    },\n    phoneNumber: '13800138003'\n  }\n];\n\n// 底部导航配置\nconst tabBarItems = [\n  {\n    key: 'pool',\n    title: '我的运力池',\n    icon: 'truck-filled',\n    selected: true\n  },\n  {\n    key: 'delivery',\n    title: '熟车发货',\n    icon: 'package',\n    selected: false\n  },\n  {\n    key: 'goods',\n    title: '我的货源',\n    icon: 'inbox',\n    selected: false\n  },\n  {\n    key: 'profile',\n    title: '个人中心',\n    icon: 'user',\n    selected: false\n  }\n];\n\n// 筛选选项配置\nconst filterOptions = [\n  {\n    key: 'sort',\n    title: '智能排序',\n    value: 'smart'\n  },\n  {\n    key: 'option2',\n    title: '选项二',\n    value: 'option2'\n  },\n  {\n    key: 'option3', \n    title: '选项三',\n    value: 'option3'\n  }\n];\n\nconst MyTransportPool: React.FC = () => {\n  const [searchKeyword, setSearchKeyword] = useState('');\n  const [drivers, setDrivers] = useState<DriverInfo[]>(mockDrivers);\n  const [selectedTab, setSelectedTab] = useState('pool');\n  const [filters, setFilters] = useState({\n    sort: 'smart',\n    option2: false,\n    option3: false\n  });\n\n  // 处理搜索\n  const handleSearch = (value: string) => {\n    setSearchKeyword(value);\n    // 这里可以添加搜索逻辑\n  };\n\n  // 处理筛选变化\n  const handleFilterChange = (key: string, value: any) => {\n    setFilters(prev => ({\n      ...prev,\n      [key]: value\n    }));\n    // 这里可以添加筛选逻辑\n  };\n\n  // 处理标签栏切换\n  const handleTabChange = (key: string) => {\n    setSelectedTab(key);\n    // 这里可以添加页面切换逻辑\n  };\n\n  // 处理拨打电话\n  const handleCall = (phoneNumber: string) => {\n    // 这里可以添加拨打电话逻辑\n    console.log('拨打电话:', phoneNumber);\n  };\n\n  // 处理添加熟车\n  const handleAddDriver = () => {\n    // 这里可以添加添加熟车逻辑\n    console.log('添加熟车');\n  };\n\n  // 渲染司机卡片\n  const renderDriverCard = (driver: DriverInfo) => (\n    <Card key={driver.id} style={{ marginBottom: '16px' }}>\n      <Row align=\"top\" gutter={16}>\n        <Col span={4}>\n          <Avatar\n            src={driver.avatar}\n            size={80}\n            style={{ borderRadius: '12px' }}\n          />\n        </Col>\n        <Col span={16}>\n          <Row justify=\"space-between\" align=\"top\">\n            <Col span={20}>\n              <Text style={{ fontSize: '28px', lineHeight: '40px', fontWeight: 'normal' }}>\n                {driver.name} | {driver.licensePlate} | {driver.vehicleType}\n              </Text>\n              <Row style={{ marginTop: '8px' }} gutter={8}>\n                <Tag \n                  type=\"success\" \n                  size=\"small\"\n                  style={{ backgroundColor: '#FFF0E6', color: '#FF7000' }}\n                >\n                  通话次数 {driver.callCount}\n                </Tag>\n                <Tag \n                  type=\"warning\" \n                  size=\"small\"\n                  style={{ backgroundColor: '#FFF0E6', color: '#FF7000' }}\n                >\n                  好评率{driver.rating}%\n                </Tag>\n                <Tag \n                  type=\"warning\" \n                  size=\"small\"\n                  style={{ backgroundColor: '#FFF0E6', color: '#FF7000' }}\n                >\n                  交易数 {driver.dealCount}\n                </Tag>\n                {driver.tags.map((tag, index) => (\n                  <Tag \n                    key={index}\n                    type=\"warning\" \n                    size=\"small\"\n                    style={{ \n                      backgroundColor: index === driver.tags.length - 1 ? 'transparent' : '#E6F4FF',\n                      color: index === driver.tags.length - 1 ? '#FF7000' : '#1A6FFF',\n                      border: index === driver.tags.length - 1 ? '1px solid #FF7000' : 'none'\n                    }}\n                  >\n                    {tag}\n                  </Tag>\n                ))}\n              </Row>\n            </Col>\n            <Col span={4} style={{ textAlign: 'right' }}>\n              <Button\n                type=\"primary\"\n                shape=\"circle\"\n                size=\"large\"\n                icon=\"phone\"\n                style={{ \n                  backgroundColor: '#FF7000',\n                  borderColor: '#FF7000',\n                  width: '48px',\n                  height: '48px'\n                }}\n                onClick={() => handleCall(driver.phoneNumber)}\n              />\n            </Col>\n          </Row>\n        </Col>\n      </Row>\n      \n      <Card style={{ marginTop: '16px', backgroundColor: '#F9F9F9' }}>\n        <Row align=\"middle\" style={{ marginBottom: '16px' }}>\n          <Col span={4}>\n            <Row align=\"middle\" gutter={8}>\n              <Icon name=\"route\" size=\"small\" />\n              <Text style={{ fontSize: '24px', color: '#666666' }}>常跑线路</Text>\n            </Row>\n          </Col>\n          <Col span={20}>\n            <Text style={{ fontSize: '24px', color: '#1A1A1A' }}>\n              {driver.routes}\n            </Text>\n          </Col>\n        </Row>\n        <Row align=\"middle\">\n          <Col span={4}>\n            <Row align=\"middle\" gutter={8}>\n              <Icon name=\"location\" size=\"small\" />\n              <Text style={{ fontSize: '24px', color: '#666666' }}>最新定位</Text>\n            </Row>\n          </Col>\n          <Col span={20}>\n            {driver.location.isLoading ? (\n              <Text style={{ fontSize: '24px', color: '#666666' }}>\n                正在努力获取定位中…\n              </Text>\n            ) : (\n              <div>\n                <Text style={{ fontSize: '24px', color: '#1A1A1A' }}>\n                  {driver.location.address} {driver.location.updateTime}\n                </Text>\n                <br />\n                <Text style={{ fontSize: '24px', color: '#1A1A1A' }}>\n                  {driver.location.distance}\n                </Text>\n              </div>\n            )}\n          </Col>\n        </Row>\n      </Card>\n    </Card>\n  );\n\n  return (\n    <Container style={{ width: '720px', minHeight: '1560px', backgroundColor: '#F5F5F5' }}>\n      {/* 状态栏 */}\n      <StatusBar theme=\"dark\" platform=\"ios\" />\n      \n      {/* 导航栏 */}\n      <NavigationBar\n        title=\"我的运力池\"\n        backgroundColor=\"#FFFFFF\"\n        titleStyle={{ fontSize: '36px', lineHeight: '50px' }}\n        renderRight={() => (\n         Button({\n            type: \"default\",\n            size: \"small\",\n            children: \"更多\"\n          })\n        )}\n      />\n      \n      {/* 搜索和筛选区域 */}\n      <Container style={{ padding: '0 24px', backgroundColor: '#FFFFFF', marginBottom: '16px' }}>\n        <SearchInput\n          placeholder=\"请输入司机姓名/车牌号\"\n          value={searchKeyword}\n          onChange={handleSearch}\n          style={{ marginBottom: '16px' }}\n        />\n        \n        <Row gutter={0}>\n          {filterOptions.map(option => (\n            <Col span={8} key={option.key}>\n              <Dropdown\n                title={option.title}\n                selected={filters[option.key as keyof typeof filters]}\n                onSelect={(value) => handleFilterChange(option.key, value)}\n              />\n            </Col>\n          ))}\n        </Row>\n      </Container>\n      \n      {/* 司机列表 */}\n      <Container style={{ padding: '0 24px' }}>\n        {drivers.map(driver => renderDriverCard(driver))}\n      </Container>\n      \n      {/* 添加熟车浮动按钮 */}\n      <Button\n        type=\"primary\"\n        shape=\"circle\"\n        size=\"large\"\n        icon=\"plus\"\n        style={{\n          position: 'fixed',\n          bottom: '120px',\n          right: '24px',\n          backgroundColor: '#FFFFFF',\n          borderColor: '#FFE2CC',\n          color: '#FF7000',\n          width: '96px',\n          height: '96px',\n          boxShadow: '0 4px 12px rgba(0,0,0,0.15)'\n        }}\n        onClick={handleAddDriver}\n      />\n      \n      {/* 底部导航栏 */}\n      <TabBar\n        items={tabBarItems}\n        selected={selectedTab}\n        onChange={handleTabChange}\n        style={{ \n          position: 'fixed',\n          bottom: 0,\n          left: 0,\n          right: 0,\n          height: '96px',\n          backgroundColor: '#FFFFFF'\n        }}\n      />\n    </Container>\n  );\n};\n\nexport default MyTransportPool;"},"category":"write"}

