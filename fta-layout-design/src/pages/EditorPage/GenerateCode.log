data: {"toolName":"propose_file","callId":"chatcmpl-tool-09a242a2f2404d9cbac08b5825ce3f25","params":{"path":"src/pages/MyTransportPool.tsx","kind":"file","description":"我的运力池页面 - 更新版本，使用可复用组件","content":"import React, { useState, useEffect } from 'react';\nimport { \n  StatusBar, \n  NavigationBar, \n  Container,\n  Text\n} from '@fta/components';\n\nimport { DriverInfo, FilterState } from '../types/driver';\nimport { mockDrivers, tabBarItems, filterOptions } from '../data/mockData';\nimport DriverCard from '../components/DriverCard';\nimport SearchAndFilter from '../components/SearchAndFilter';\nimport BottomTabBar from '../components/BottomTabBar';\nimport FloatingAddButton from '../components/FloatingAddButton';\n\nconst MyTransportPool: React.FC = () => {\n  const [searchKeyword, setSearchKeyword] = useState('');\n  const [drivers, setDrivers] = useState<DriverInfo[]>(mockDrivers);\n  const [selectedTab, setSelectedTab] = useState('pool');\n  const [filters, setFilters] = useState<FilterState>({\n    sort: 'smart',\n    option2: false,\n    option3: false\n  });\n\n  // 处理搜索\n  const handleSearchChange = (value: string) => {\n    setSearchKeyword(value);\n    // TODO: 实现搜索逻辑\n    console.log('搜索关键词:', value);\n  };\n\n  // 处理筛选变化\n  const handleFilterChange = (key: string, value: any) => {\n    setFilters(prev => ({\n      ...prev,\n      [key]: value\n    }));\n    // TODO: 实现筛选逻辑\n    console.log('筛选变化:', key, value);\n  };\n\n  // 处理标签栏切换\n  const handleTabChange = (key: string) => {\n    setSelectedTab(key);\n    // TODO: 实现页面切换逻辑\n    console.log('切换到:', key);\n  };\n\n  // 处理拨打电话\n  const handleCall = (phoneNumber: string) => {\n    // TODO: 实现拨打电话逻辑\n    console.log('拨打电话:', phoneNumber);\n    // 这里可以调用系统拨号功能\n    // window.location.href = `tel:${phoneNumber}`;\n  };\n\n  // 处理添加熟车\n  const handleAddDriver = () => {\n    // TODO: 实现添加熟车逻辑\n    console.log('添加熟车');\n    // 这里可以跳转到添加熟车页面或显示弹窗\n  };\n\n  // 模拟数据获取\n  useEffect(() => {\n    // TODO: 从API获取司机数据\n    console.log('页面加载，获取司机数据');\n  }, []);\n\n  return (\n    <Container style={{ \n      width: '720px', \n      minHeight: '100vh', \n      backgroundColor: '#F5F5F5',\n      paddingBottom: '96px' // 为底部导航留出空间\n    }}>\n      {/* 状态栏 */}\n      <StatusBar theme=\"dark\" platform=\"ios\" />\n      \n      {/* 导航栏 */}\n      <NavigationBar\n        title=\"我的运力池\"\n        backgroundColor=\"#FFFFFF\"\n        titleStyle={{ \n          fontSize: '36px', \n          lineHeight: '50px',\n          fontWeight: '500'\n        }}\n        renderRight={() => (\n          <Text style={{\n            fontSize: '28px',\n            color: '#666666',\n            padding: '8px 16px'\n          }}>\n            完成\n          </Text>\n        )}\n      />\n      \n      {/* 搜索和筛选区域 */}\n      <SearchAndFilter\n        searchKeyword={searchKeyword}\n        onSearchChange={handleSearchChange}\n        filters={filters}\n        onFilterChange={handleFilterChange}\n        filterOptions={filterOptions}\n      />\n      \n      {/* 司机列表 */}\n      <Container style={{ padding: '0 24px' }}>\n        {drivers.length > 0 ? (\n          drivers.map(driver => (\n            <DriverCard\n              key={driver.id}\n              driver={driver}\n              onCall={handleCall}\n            />\n          ))\n        ) : (\n          <Container style={{ \n            textAlign: 'center', \n            padding: '60px 24px',\n            backgroundColor: '#FFFFFF',\n            borderRadius: '16px',\n            marginTop: '24px'\n          }}>\n            <Text style={{ \n              fontSize: '28px', \n              color: '#666666',\n              lineHeight: '40px'\n            }}>\n              暂无司机数据\n            </Text>\n            <Text style={{ \n              fontSize: '24px', \n              color: '#999999',\n              lineHeight: '34px',\n              marginTop: '12px'\n            }}>\n              请调整搜索条件或添加熟车\n            </Text>\n          </Container>\n        )}\n      </Container>\n      \n      {/* 添加熟车浮动按钮 */}\n      <FloatingAddButton onClick={handleAddDriver} />\n      \n      {/* 底部导航栏 */}\n      <BottomTabBar\n        items={tabBarItems}\n        selected={selectedTab}\n        onChange={handleTabChange}\n      />\n    </Container>\n  );\n};\n\nexport default MyTransportPool;"},"category":"write"}

