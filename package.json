{
  "name": "amh-code-agent",
  "private": true,
  "version": "0.0.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "packages/shared/**",
      "packages/dsl-demo/**",
      "packages/fta-layout-design/**"
    ]
  },
  "scripts": {
    "build": "yarn workspace @fta/shared build && yarn workspace @fta/agent-core build && yarn workspace code-agent-backend build",
    "dev:backend": "yarn workspace code-agent-backend dev",
    "dev:frontend": "yarn workspace fta-layout-design dev"
  },
  "resolutions": {
    "esbuild": "0.25.12",
    "zod": "4.1.12"
  },
  "engines": {
    "node": "=20"
  }
}
