{
  "name": "amh-code-agent",
  "private": true,
  "version": "0.0.0",
  "workspaces": {
    "packages": [
      "shared-types",
      "code-agent-backend",
      "dsl-demo",
      "fta-layout-design",
      "fta-agent-core"
    ],
    "nohoist": [
      "**/dsl-demo/**",
      "**/fta-layout-design/**"
    ]
  },
  "scripts": {
    "bootstrap": "yarn install",
    "build": "yarn workspace @fta/shared-types build && yarn workspace @fta/agent-core build && yarn workspace code-agent-backend build",
    "dev:backend": "yarn workspace code-agent-backend dev",
    "dev:frontend": "yarn workspace master-go-design dev",
    "dev:replayer": "yarn workspace messages-replayer replay",
    "typecheck": "yarn workspace @fta/agent-core typecheck"
  },
  "resolutions": {
    "esbuild": "0.25.12",
    "zod": "4.1.12"
  },
  "engines": {
    "node": "=20"
  }
}
