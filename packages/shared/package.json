{
  "name": "@fta/shared",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./data/*": {
      "import": "./dist/data/*",
      "require": "./dist/data/*"
    }
  },
  "types": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^19.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "=20"
  }
}
